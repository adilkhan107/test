# Database. SQLite by default; for Postgres use e.g. postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///./data/nirmaanai.db

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where uploads (deleted after analysis) and violation snapshots are kept
DATA_DIR=./data

# Upload limits
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=900

# Analyze one frame every N seconds of video
SAMPLE_EVERY_SECONDS=1.0

# Which PPE counts toward compliance: hardhat,vest,mask
REQUIRED_PPE=hardhat,vest,mask

# Model (loaded with torch pickle -> pin a commit hash from the HF repo page in production)
MODEL_REPO=mancalazure/construction-ppe-safety
MODEL_FILENAME=best.pt
MODEL_REVISION=
CONF_THRESHOLD=0.25
